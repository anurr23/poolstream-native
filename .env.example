# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Jangan commit file .env.
# Semua nilai dibaca apa adanya; tidak ada fallback di file config lain.

APP_NAME=PoolStream
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=poolstream
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=+07:00
DB_TIMEOUT=3

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=http://localhost/poolstream-native/google-auth.php?action=callback

AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
AI_MODEL=ag/gemini-3.8-flash-high
AI_TIMEOUT=0
AI_MAX_TOKENS=16384

MAIL_DRIVER=log
MAIL_FROM=no-reply@poolstream.test
MAIL_FROM_NAME=PoolStream
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
